# Generate independent random values before running Docker Compose.
GLINE_POSTGRES_PASSWORD=replace-with-a-random-database-password
GLINE_BOOTSTRAP_TOKEN=replace-with-a-random-admin-token
GLINE_API_KEY_PEPPER=replace-with-a-random-api-key-pepper

# Optional host ports.
GLINE_HTTP_PORT=8080
GLINE_WEB_PORT=4173
GLINE_POSTGRES_PORT=5432

# Optional operational limits.
GLINE_INGEST_REQUESTS_PER_MINUTE=600
GLINE_INGEST_ENTRIES_PER_MINUTE=120000
GLINE_INGEST_BYTES_PER_MINUTE=268435456
GLINE_INGEST_MAX_INFLIGHT=16
GLINE_QUERY_CONCURRENCY=8
GLINE_QUERY_TIMEOUT=10s
GLINE_MAINTENANCE_INTERVAL=1m
GLINE_AGENT_STALE_AFTER=2m
GLINE_RETENTION_BATCH_SIZE=1000
